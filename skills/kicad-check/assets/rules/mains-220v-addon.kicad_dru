(version 1)
# ADD-ON for boards with Thai mains (220-230 V AC, 50 Hz). KiCad 9+ only:
# KiCad 8 has no creepage constraint or hasNetclass(), and KiCad silently
# ignores a rules file it cannot parse. Append everything after the first
# line to your fab preset:
#     tail -n +2 mains-220v-addon.kicad_dru >> <project>.kicad_dru
# Net classes:
#   Mains     every net at mains voltage (L, N, after fuse, rectifier input, relay contacts)
#   Mains_HV  nets whose working voltage exceeds 250 Vrms/DC: rectified DC bus
#             (~325 V), switcher primary / flyback drain. Measure it.
#
# Values: IEC 62368-1:2018 (= มอก. 62368 เล่ม 1-2563), mains transient 2500 V
# peak (OVC II), pollution degree 2, material group III (ordinary FR-4),
# altitude <= 2000 m:
#   <= 250 V   functional (L-N) creepage 2.5 mm  | reinforced clearance 3.0, creepage 5.0 mm
#   <= 320 V   functional creepage 3.2 mm        | reinforced creepage 6.4 mm
# Repetitive peaks above the mains peak (flyback ringing) need more clearance:
# look it up for the measured peak. These are design-start values, not a
# certification. Appliances (มอก. 60335) and humid/dirty sites (pollution
# degree 3) need more. Confirm with the standard and a test lab (EEI / PTEC).
# Slots in Edge.Cuts count for creepage; solder mask and coating do not.
# Later rules win, so each HV rule comes after its 250 V counterpart.

(rule "Mains functional (L-N): clearance"
	(constraint clearance (min 1.5mm))
	(condition "(A.hasNetclass('Mains') || A.hasNetclass('Mains_HV')) && (B.hasNetclass('Mains') || B.hasNetclass('Mains_HV')) && A.Net != B.Net"))
(rule "Mains functional (L-N): creepage"
	(constraint creepage (min 2.5mm))
	(condition "(A.hasNetclass('Mains') || A.hasNetclass('Mains_HV')) && (B.hasNetclass('Mains') || B.hasNetclass('Mains_HV')) && A.Net != B.Net"))
(rule "Mains_HV functional: creepage"
	(constraint creepage (min 3.2mm))
	(condition "(A.hasNetclass('Mains_HV') || B.hasNetclass('Mains_HV')) && (A.hasNetclass('Mains') || A.hasNetclass('Mains_HV')) && (B.hasNetclass('Mains') || B.hasNetclass('Mains_HV')) && A.Net != B.Net"))
(rule "Mains to low voltage: reinforced clearance"
	(constraint clearance (min 3.0mm))
	(condition "((A.hasNetclass('Mains') || A.hasNetclass('Mains_HV')) && !B.hasNetclass('Mains') && !B.hasNetclass('Mains_HV')) || ((B.hasNetclass('Mains') || B.hasNetclass('Mains_HV')) && !A.hasNetclass('Mains') && !A.hasNetclass('Mains_HV'))"))
(rule "Mains to low voltage: reinforced creepage"
	(constraint creepage (min 5.0mm))
	(condition "((A.hasNetclass('Mains') || A.hasNetclass('Mains_HV')) && !B.hasNetclass('Mains') && !B.hasNetclass('Mains_HV')) || ((B.hasNetclass('Mains') || B.hasNetclass('Mains_HV')) && !A.hasNetclass('Mains') && !A.hasNetclass('Mains_HV'))"))
(rule "Mains_HV to low voltage: reinforced creepage"
	(constraint creepage (min 6.4mm))
	(condition "(A.hasNetclass('Mains_HV') && !B.hasNetclass('Mains') && !B.hasNetclass('Mains_HV')) || (B.hasNetclass('Mains_HV') && !A.hasNetclass('Mains') && !A.hasNetclass('Mains_HV'))"))
